    "LogTable": "src/components/LogTable.tsx",
    "OnboardingChecklist": "src/components/OnboardingChecklist.tsx",
    "ReportGenerator": "src/components/ReportGenerator.tsx",
    "ResetPassword": "src/components/ResetPassword.tsx",
    "SystemSettings": "src/components/SystemSettings.tsx",
    "UpgradeModal": "src/components/UpgradeModal.tsx"
